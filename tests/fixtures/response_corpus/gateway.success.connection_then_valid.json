{
  "id": "gateway.success.connection_then_valid",
  "kind": "gateway",
  "description": "A connection failure falls back to the next provider.",
  "expects_json_object": false,
  "request": {},
  "providers": [
    {
      "name": "alpha"
    },
    {
      "name": "beta"
    }
  ],
  "max_attempts": 2,
  "responses": [
    {
      "raise": "connect_error"
    },
    {
      "status": 200,
      "content_type": "application/json",
      "body_encoding": "utf-8",
      "body": "{\"id\":\"chatcmpl-fixture\",\"object\":\"chat.completion\",\"created\":1700000000,\"model\":\"fixture-model\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
    }
  ],
  "expect": {
    "outcome": "success",
    "status_code": 200,
    "attempts": [
      {
        "outcome": "failure",
        "status_code": null,
        "error_category": "connection_error",
        "fallback_attempted": true
      },
      {
        "outcome": "success",
        "status_code": 200,
        "error_category": null,
        "fallback_attempted": false
      }
    ],
    "provider_index": 1,
    "content_type": "application/json",
    "body_encoding": "utf-8",
    "body": "{\"id\":\"chatcmpl-fixture\",\"object\":\"chat.completion\",\"created\":1700000000,\"model\":\"fixture-model\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"ok\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"
  }
}
